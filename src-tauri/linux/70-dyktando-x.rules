# Dyktando X: global shortcuts read the keyboard from /dev/input (works on X11 and Wayland),
# while blocking shortcuts and pasting via dotool/ydotool needs /dev/uinput.
# "uaccess" grants access only to the user logged in at the machine (not over SSH).
KERNEL=="uinput", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", TAG+="uaccess"
